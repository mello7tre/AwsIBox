# vim: ft=python
import boto3
import logging

# logging.basicConfig()
logger = logging.getLogger(__name__)
logging_handler = logging.StreamHandler()
logger.addHandler(logging_handler)
logger.setLevel(logging.INFO)
logger.propagate = False


RESOURCE_EC2 = boto3.resource("ec2")
CLIENT_ECS = boto3.client("ecs")
CLIENT_AUTOSCALING = boto3.client("autoscaling")


def find_cluster(tags):
    for n in tags:
        if n["Key"] == "ECSCluster":
            return n["Value"]


def find_container_instance(cluster, instance_id, status=None):
    status_desc = ""
    kwargs = {"cluster": cluster, "filter": f"ec2InstanceId == {instance_id}"}

    if status:
        kwargs["status"] = status
        status_desc = f" in status {status}"

    list_resp = CLIENT_ECS.list_container_instances(**kwargs)

    try:
        instance_arn = list_resp["containerInstanceArns"][0]
        logger.info(f"Found {instance_arn}{status_desc}")
        return instance_arn
    except Exception:
        logger.warning(f"No Container Instance{status_desc}")
        return False


def deregister_container_instance(cluster, instance_id):
    instance_arn = find_container_instance(cluster, instance_id)

    if not instance_arn:
        return

    try:
        resp = CLIENT_ECS.deregister_container_instance(
            cluster=cluster,
            containerInstance=instance_arn,
            force=True,
        )
    except Exception as e:
        logger.error(f"{instance_id} - Error Deregistering from Cluster {cluster}: {e}")
    else:
        status = resp.get("containerInstance", {}).get("status")
        logger.info(
            f"{instance_id} deregistered from cluster {cluster}, current status is: {status}"
        )


def complete_lifecycle(asg_name, instance_id, lifecyclehook_name):
    try:
        CLIENT_AUTOSCALING.complete_lifecycle_action(
            LifecycleHookName=lifecyclehook_name,
            AutoScalingGroupName=asg_name,
            LifecycleActionResult="ABANDON",
            InstanceId=instance_id,
        )
    except Exception as e:
        logger.error(
            f"{asg_name} {instance_id} Error completing lifecycle {lifecyclehook_name}: {e}"
        )
    else:
        logger.info(
            f"{asg_name} {instance_id} - Completed lifecycle {lifecyclehook_name}"
        )


def lambda_handler(event, context):
    instance_id = event["detail"]["EC2InstanceId"]
    asg_name = event["detail"]["AutoScalingGroupName"]
    lifecyclehook_name = event["detail"]["LifecycleHookName"]
    lifecyclehook_action = event["detail"]["LifecycleTransition"]

    logger.info(f"{asg_name} - {instance_id} - {lifecyclehook_action}")

    instance = RESOURCE_EC2.Instance(instance_id)

    cluster = find_cluster(instance.tags)

    if not cluster or instance.state["Name"] != "stopped":
        return

    logger.info(f"{instance_id} - Found Cluster ECS: {cluster}")

    complete_lifecycle(asg_name, instance_id, lifecyclehook_name)
    deregister_container_instance(cluster, instance_id)
