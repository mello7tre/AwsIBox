# vim: ft=python
import boto3
import logging
import urllib.request
import os
import json
from pprint import pformat

#logging.basicConfig()
logger = logging.getLogger()
logger.setLevel(logging.INFO)

SNS_TOPIC = os.environ["SNSTopic"]
LOAD_BALANCER = os.environ["LoadBalancer"]
STACK_NAME = os.environ["StackName"]

CLIENT_SNS = boto3.client("sns")

GOOD_HEALTH = ["green"]

def lambda_handler(event, context):
    req = urllib.request.Request(
        f"http://{LOAD_BALANCER}:9200/_cluster/health", method="GET"
    )

    f = urllib.request.urlopen(req)

    resp = json.loads(f.read())

    logger.info(resp)

    status = resp["status"]

    if status not in GOOD_HEALTH:
        subj = f"ElasticSearch {STACK_NAME} status is: {status} :warning:"
        msg = pformat(resp)

        sns_msg = {
            "default": msg,
            "https": json.dumps(
                {
                    "version": "1.0",
                    "source": "custom",
                    "content": {
                        "title": subj,
                        "description": msg,
                    },
                    "metadata": {
                        "enableCustomActions": False,
                    },
                }
            ),
        }

        logger.info(subj)

        pub_result = CLIENT_SNS.publish(
            TopicArn=SNS_TOPIC,
            Subject=subj,
            Message=json.dumps(sns_msg),
            MessageStructure="json",
        )

        logger.info(pub_result)

#lambda_handler("", "")
